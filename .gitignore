# Repo-wide
__pycache__/
*.pyc
.DS_Store
node_modules/
dist/
out/
dev-models/

# --- original-support-fins/ (the original project) ----------------------
# Patterns containing a slash are anchored to this file's directory, so they
# carry the original-support-fins/ prefix.
*.stl
!original-support-fins/tests/fixtures/*.stl
# test models the Deno suite loads (tests/_util.js MODELS); regenerate with
# original-support-fins/prototype/stress/gen.py. Committed so CI and fresh
# checkouts can run the tests.
original-support-fins/prototype/stress/models/*
!original-support-fins/prototype/stress/models/*.stl
original-support-fins/plugins/orca/build/
original-support-fins/plugins/orca-wave/build/
original-support-fins/plugins/orca-infill/build/
original-support-fins/plugins/orca-wave/**/wave_overhangs_log.jsonl

# example models: Thingi10K ones keep third-party licenses, so they're fetched
# locally (fetch_thingi.py), never committed
original-support-fins/prototype/examples/real/

# --- my-plugins/ --------------------------------------------------------
# NOTE: the built plugin under each my-plugins/<id>/ IS the released artifact
# that Install-Orca-Plugins.bat downloads, so those .py files are committed on
# purpose. Only throwaway output is ignored here.
my-plugins/**/*.log

# local dev virtualenv (pytest/numpy/shapely for the plugin test suites)
.venv/

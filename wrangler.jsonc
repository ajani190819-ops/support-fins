{
  // printfins.com is a fully static site — every file lives in
  // original-support-fins/web/ and runs in the browser (no server code).
  // Cloudflare's git integration deploys this repo as a Workers "static assets"
  // project (named support-fins in the dashboard), so it needs this config to
  // know WHERE the site is. No "main" key = there is no Worker script, just
  // files; original-support-fins/web/_redirects still applies under Static Assets.
  //
  // This file stays at the REPO ROOT even though the site lives in a subfolder:
  // Cloudflare's git integration looks for the wrangler config at the configured
  // root directory (default: the repo root). Moving it would need a matching
  // "Root directory" change in the Cloudflare dashboard.
  //
  // "assets.directory" below is the one line that has to track the folder name.
  // It was ./support-fins/web before the 2026-09-30 reorganisation.
  "name": "support-fins",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./original-support-fins/web"
  }
}
